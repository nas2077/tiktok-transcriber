# windows scripts keep windows line endings whatever git is set to: cmd
# misreads labels in a .bat with bare LF, and powershell 5.1 is happier too
*.bat  text eol=crlf
*.ps1  text eol=crlf

# license texts are checked against upstream SHA-256 values: keep their bytes
src/licenses/** -text

# shell scripts run on macOS and Linux: LF even in a windows checkout
*.sh   text eol=lf
PKGBUILD text eol=lf

# everything else: LF in the repository
*      text=auto
*.ico  binary
*.png  binary
